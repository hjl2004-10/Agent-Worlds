  "lore": {
    "world_name": "阳光大学",
    "background": "这是一所现代中国大学校园。校园里有教学楼、图书馆、宿舍、食堂、体育馆和行政楼，中央广场上有喷泉和雕塑。教师授课、学生赶课、保安值守、配送员穿梭，每个人都在校园里过着自己的生活。角色之间可以相遇、聊天、合作。",
    "rules": [
      "角色在校园中自由活动，可以上课、自习、吃饭、运动",
      "中央广场是人流汇集的地方，适合偶遇和聊天",
      "校园作息以课程表为节奏，上课时段教学楼人多",
      "对话压缩输出，工作正常使用"
    ],
    "history": [
      "九月开学季，新学期开始",
      "校园迎来了新的一批学生"
    ]
  },
